{
  "name": "voidframe",
  "version": "1.0.0",
  "description": "Dark monochrome React UI framework. Terminal-brutalist. Data-dense. Zero border-radius. Monospace-first.",
  "type": "module",
  "main": "dist/voidframe.cjs.js",
  "module": "dist/voidframe.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/voidframe.es.js",
      "require": "./dist/voidframe.cjs.js"
    },
    "./styles.css": "./dist/voidframe.css",
    "./tokens": {
      "types": "./dist/types/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./theme-script.js": "./theme-script.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "theme-script.js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "demo": "vite serve demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ssr": "vitest run src/__tests__/ssr.test.tsx",
    "test:a11y": "vitest run src/components/__tests__/a11yAxe.test.tsx"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "happy-dom": "^14.12.0",
    "jest-axe": "^9.0.0",
    "@types/jest-axe": "^3.5.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.8.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "react",
    "ui",
    "framework",
    "dark-theme",
    "monospace",
    "brutalist",
    "terminal",
    "components",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/voidframe"
  }
}
