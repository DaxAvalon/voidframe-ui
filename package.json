{
  "name": "voidframe",
  "version": "1.0.0",
  "description": "Dark monochrome React UI framework. Terminal-brutalist. Data-dense. Zero border-radius. Monospace-first.",
  "type": "module",
  "main": "dist/voidframe.cjs.js",
  "module": "dist/voidframe.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/voidframe.es.js",
      "require": "./dist/voidframe.cjs.js"
    },
    "./charts": {
      "types": "./dist/types/charts/index.d.ts",
      "import": "./dist/charts.es.js",
      "require": "./dist/charts.cjs.js"
    },
    "./dev": {
      "types": "./dist/types/dev/index.d.ts",
      "import": "./dist/dev.es.js",
      "require": "./dist/dev.cjs.js"
    },
    "./styles.css": "./dist/voidframe.css",
    "./tokens": {
      "types": "./dist/types/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./theme-script.js": "./theme-script.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme-script.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "demo": "vite serve demo",
    "docs": "npm run docs:extract-props && vite serve docs",
    "docs:build": "npm run docs:extract-props && vite build --config docs/vite.config.ts",
    "docs:extract-props": "node scripts/extract-props.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ssr": "vitest run src/__tests__/ssr.test.tsx",
    "test:a11y": "vitest run src/components/__tests__/a11yAxe.test.tsx",
    "size": "size-limit",
    "analyze": "ANALYZE=1 vite build && echo 'Bundle analysis written to dist/stats.html'",
    "lint:build": "tsc -p tools/eslint-plugin-voidframe/tsconfig.json",
    "lint:voidframe": "npm run lint:build && eslint --rulesdir tools/eslint-plugin-voidframe/dist/rules --ext .ts,.tsx,.js,.jsx",
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:write": "node scripts/generate-changelog.mjs --write",
    "codemod": "node tools/codemods/run.mjs",
    "cli": "node tools/cli/bin/voidframe.mjs",
    "vscode:snippets": "node scripts/generate-vscode-snippets.mjs",
    "vscode:package": "node scripts/package-vscode.mjs",
    "prepublishOnly": "npm run typecheck && npm test -- --run && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "size-limit": [
    {
      "name": "Core ESM (dist/voidframe.es.js)",
      "path": "dist/voidframe.es.js",
      "limit": "170 KB",
      "gzip": true
    },
    {
      "name": "Charts ESM (dist/charts.es.js)",
      "path": "dist/charts.es.js",
      "limit": "40 KB",
      "gzip": true
    },
    {
      "name": "Dev ESM (dist/dev.es.js)",
      "path": "dist/dev.es.js",
      "limit": "10 KB",
      "gzip": true
    },
    {
      "name": "Stylesheet (dist/voidframe.css)",
      "path": "dist/voidframe.css",
      "limit": "40 KB",
      "gzip": true
    },
    {
      "name": "All JS (ES + CJS, all entries)",
      "path": "dist/*.js",
      "limit": "400 KB",
      "gzip": true
    }
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "d3-array": ">=3.0.0",
    "d3-force": ">=3.0.0",
    "d3-geo": ">=3.0.0",
    "d3-hierarchy": ">=3.0.0",
    "d3-sankey": ">=0.12.0",
    "d3-scale": ">=4.0.0",
    "d3-shape": ">=3.0.0",
    "d3-time": ">=3.0.0",
    "topojson-client": ">=3.0.0",
    "dompurify": ">=3.0.0",
    "react-live": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "d3-array": { "optional": true },
    "d3-force": { "optional": true },
    "d3-geo": { "optional": true },
    "d3-hierarchy": { "optional": true },
    "d3-sankey": { "optional": true },
    "d3-scale": { "optional": true },
    "d3-shape": { "optional": true },
    "d3-time": { "optional": true },
    "topojson-client": { "optional": true },
    "dompurify": { "optional": true },
    "react-live": { "optional": true }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-time": "^3.0.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "dompurify": "^3.2.0",
    "topojson-client": "^3.1.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "happy-dom": "^14.12.0",
    "jest-axe": "^9.0.0",
    "@types/jest-axe": "^3.5.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.8.0",
    "vitest": "^1.6.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/utils": "^7.18.0",
    "@typescript-eslint/rule-tester": "^7.18.0",
    "eslint": "^8.57.0",
    "jscodeshift": "^0.15.2",
    "@types/jscodeshift": "^0.11.11",
    "rollup-plugin-visualizer": "^5.12.0",
    "size-limit": "^11.1.4",
    "@size-limit/file": "^11.1.4",
    "react-live": "^4.1.6",
    "react-docgen-typescript": "^2.2.2",
    "commander": "^12.1.0",
    "@vscode/vsce": "^2.29.0",
    "@types/vscode": "^1.84.0"
  },
  "keywords": [
    "react",
    "ui",
    "framework",
    "dark-theme",
    "monospace",
    "brutalist",
    "terminal",
    "components",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/voidframe"
  }
}
