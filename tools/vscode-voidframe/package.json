{
  "name": "vscode-voidframe",
  "displayName": "Voidframe",
  "description": "Snippets, hover docs, and quick actions for the Voidframe React UI framework.",
  "version": "1.0.0",
  "publisher": "voidframe",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": ["Snippets", "Other"],
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "typescriptreact",
        "path": "./snippets/voidframe.code-snippets"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/voidframe.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/voidframe.code-snippets"
      },
      {
        "language": "javascript",
        "path": "./snippets/voidframe.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "voidframe.openPlayground",
        "title": "Voidframe: Open playground for component"
      }
    ],
    "configuration": {
      "title": "Voidframe",
      "properties": {
        "voidframe.docsUrl": {
          "type": "string",
          "default": "http://localhost:5175",
          "description": "Base URL for the Voidframe docs site. The Open Playground command opens `${docsUrl}/#<component-name>`. Default points at the local dev docs server (`npm run docs`). Set to a deployed docs URL once published."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaxAvalon/voidframe-ui.git",
    "directory": "tools/vscode-voidframe"
  }
}
